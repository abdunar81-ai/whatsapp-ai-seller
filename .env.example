# --- Server ---
PORT=3000

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (low keeps chat replies fast and cheap)
CLAUDE_EFFORT=low

# --- Sales script ---
# The bot's script and course facts (edit this file to change what it says)
SCRIPT_FILE=data/script.md
# Optional: Kaspi payment / installment link the bot sends when the customer is ready to pay
KASPI_PAYMENT_LINK=

# --- WhatsApp connector: "waha" (default) or "baileys" ---
WHATSAPP_PROVIDER=waha

# Baileys: folder holding the linked WhatsApp session
BAILEYS_AUTH_DIR=auth

# WAHA (https://waha.devlike.pro). docker compose sets WAHA_URL to http://waha:3000 for you;
# this value is for running the bot with `npm run dev` against WAHA on localhost.
WAHA_URL=http://localhost:3001
# Pick any long random string; it protects the WAHA API and dashboard.
WAHA_API_KEY=change-me
WAHA_SESSION=default

# Optional: WhatsApp number (digits only, with country code) that gets alerts (ready to pay, parent call, handoff)
ADMIN_PHONE=
