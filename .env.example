# --- Server ---
PORT=3000

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (low keeps chat replies fast and cheap)
CLAUDE_EFFORT=low

# --- Store / persona ---
STORE_NAME=My Store
STORE_CURRENCY=USD
# Optional extra instructions for the seller (tone, policies, delivery areas...)
STORE_NOTES=We deliver within the city in 1-2 days. Cash on delivery available.

# --- WhatsApp connector: "baileys" or "waha" ---
WHATSAPP_PROVIDER=baileys

# Baileys: folder holding the linked WhatsApp session
BAILEYS_AUTH_DIR=auth

# WAHA (https://waha.devlike.pro): point its webhook to http://<this-server>:3000/webhooks/waha
WAHA_URL=http://localhost:3001
WAHA_API_KEY=
WAHA_SESSION=default

# Optional: WhatsApp number (digits only, with country code) that gets human-handoff alerts
ADMIN_PHONE=
