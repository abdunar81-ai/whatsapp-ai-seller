# --- Server ---
PORT=3000
# Domain for the HTTPS admin panel (point its DNS A record at this server)
DOMAIN=glucose.kzboard.online

# --- Admin panel (https://DOMAIN/admin) ---
# Required: the panel stays off until this is set. Use a long password.
ADMIN_PASSWORD=
# Any long random string; keeps you logged in across restarts
SESSION_SECRET=

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
# claude-haiku-5-5 (cheapest) | claude-sonnet-5-5 | claude-opus-5-5 — also switchable in the admin panel
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max  (low keeps chat replies fast and cheap)
CLAUDE_EFFORT=low

# --- Sales script ---
# The bot's script and course facts (edit this file to change what it says)
SCRIPT_FILE=data/script.md
# Kaspi payment link the bot sends when the customer is ready to pay (also editable in the admin panel)
KASPI_PAYMENT_LINK=

# --- WhatsApp connector: "waha" (default) or "baileys" ---
WHATSAPP_PROVIDER=waha

# Baileys: folder holding the linked WhatsApp session
BAILEYS_AUTH_DIR=auth

# WAHA (https://waha.devlike.pro). docker compose sets WAHA_URL to http://waha:3000 for you;
# this value is for running the bot with `npm run dev` against WAHA on localhost.
WAHA_URL=http://localhost:3001
# Pick any long random string; it protects the WAHA API and dashboard.
WAHA_API_KEY=change-me
WAHA_SESSION=default

# WhatsApp number (digits only) that gets alerts (also editable in the admin panel) (ready to pay, parent call, handoff)
ADMIN_PHONE=
